{
  "name": "calendar-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.2",
  "scripts": {
    "dev": "node node_modules/nuxt/bin/nuxt.mjs dev --host",
    "build": "bun install && nuxt build",
    "preview:worker": "bun run build && bunx wrangler dev --config .output/server/wrangler.json",
    "deploy:worker": "bun run build && bunx wrangler deploy --config .output/server/wrangler.json",
    "test": "bun test",
    "translate:locales": "bun scripts/translate-locales.js"
  },
  "dependencies": {
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.8.0",
    "@nuxthub/core": "^0.10.7",
    "@nuxtjs/i18n": "^10.4.0",
    "h3": "^1.15.11",
    "nuxt": "^4.4.6"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.114",
    "@iconify-json/simple-icons": "^1.2.86",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.94.0"
  }
}
