{
  "name": "calendar-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.2",
  "scripts": {
    "dev": "node node_modules/nuxt/bin/nuxt.mjs dev --host",
    "build": "bun install && nuxt build",
    "preview:worker": "bun run build && bunx wrangler dev --config .output/server/wrangler.json",
    "deploy:worker": "bun run build && bunx wrangler deploy --config .output/server/wrangler.json",
    "test": "bun test",
    "typecheck": "nuxt typecheck",
    "translate:locales": "bun scripts/translate-locales.js",
    "generate:theme-colors": "node scripts/generate-theme-colors.js"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@nuxt/ui": "^4.11.1",
    "@nuxthub/core": "^0.10.8",
    "@nuxtjs/i18n": "^10.6.0",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "date-fns": "^4.4.0",
    "h3": "^1.15.11",
    "nuxt": "^4.5.2"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.130",
    "@iconify-json/simple-icons": "^1.2.95",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.130.0"
  }
}
