{
  "name": "calendar-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun --bun node_modules/nuxt/bin/nuxt.mjs dev --host",
    "build": "bun install && nuxt build",
    "preview:worker": "bun run build && bunx wrangler dev --config .output/server/wrangler.json",
    "deploy:worker": "bun run build && bunx wrangler deploy --config .output/server/wrangler.json",
    "test": "bun test",
    "typecheck": "nuxt typecheck",
    "lint": "nuxt prepare && eslint .",
    "translate:locales": "bun scripts/translate-locales.js",
    "generate:theme-colors": "node scripts/generate-theme-colors.js"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@nuxt/ui": "^4.11.3",
    "@nuxthub/core": "^0.10.8",
    "@nuxtjs/i18n": "^10.6.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "date-fns": "^4.4.0",
    "h3": "^1.15.11",
    "nuxt": "^4.6.0"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.141",
    "@iconify-json/simple-icons": "^1.2.99",
    "@nuxt/eslint": "^1.17.0",
    "eslint": "^10.12.0",
    "eslint-plugin-better-tailwindcss": "^4.9.0",
    "jsdom": "^30.1.2",
    "magic-string": "^1.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.12",
    "wrangler": "^4.148.0"
  }
}
