{
  "name": "calendar-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun --bun node_modules/nuxt/bin/nuxt.mjs dev",
    "build": "bun install && nuxt build",
    "preview:worker": "bun run build && bunx wrangler dev --config .output/server/wrangler.json",
    "deploy:worker": "bun run build && bunx wrangler deploy --config .output/server/wrangler.json",
    "test": "bun test",
    "translate:locales": "bun scripts/translate-locales.js",
    "generate:theme-colors": "node scripts/generate-theme-colors.js"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@nuxt/ui": "^4.12.0",
    "@nuxthub/core": "^0.10.12",
    "@nuxtjs/i18n": "^10.6.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "date-fns": "^4.4.0",
    "h3": "^2.0.8",
    "nuxt": "^4.6.4"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.151",
    "@iconify-json/simple-icons": "^1.2.101",
    "jsdom": "^30.1.3",
    "magic-string": "^1.4.5",
    "tailwindcss": "^4.3.4",
    "wrangler": "^4.157.0"
  }
}
